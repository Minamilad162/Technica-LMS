{
  "name": "technica-secure-viewer-pilot",
  "productName": "Technica Secure Viewer Pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-of-concept Windows native screenshot capture-exclusion for Technica LMS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.cjs",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.technicaconsult.lms.secureviewer.pilot",
    "productName": "Technica Secure Viewer Pilot",
    "asar": true,
    "files": ["main.cjs", "policy.cjs", "demo.html", "test.cjs", "package.json"],
    "directories": {"output": "dist"},
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "artifactName": "Technica-Secure-Viewer-Pilot-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    }
  }
}
