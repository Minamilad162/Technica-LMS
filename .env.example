# The default preserves the full local-only demo, including assessment and ASP bank.
VITE_DATA_MODE=demo
# P3 live catalog/auth/authoring mode (safe isolated bundle; exams NOT enabled).
# Use a dedicated Technica LMS Supabase project where P1 + P2 were verified.
# These are public browser build variables, NOT the service_role secret.
# VITE_DATA_MODE=supabase
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Reference: docs/current/P3_SUPABASE_LIVE_CONNECT_RUNBOOK.md
